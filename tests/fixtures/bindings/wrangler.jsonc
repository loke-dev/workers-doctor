{
  "name": "binding-surface",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "vars": {
    "API_ORIGIN": "https://example.com"
  },
  "wasm_modules": {
    "PARSER": "./parser.wasm"
  },
  "text_blobs": {
    "COPY": "./copy.txt"
  },
  "data_blobs": {
    "LOOKUP": "./lookup.bin"
  },
  "agent_memory": [
    {
      "binding": "MEMORY",
      "namespace": "assistant-memory",
      "remote": true
    }
  ],
  "ai_search": [
    {
      "binding": "SEARCH",
      "instance_name": "docs"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "logfwdr": {
    "bindings": [
      {
        "name": "LOGS",
        "destination": "analytics"
      }
    ]
  },
  "pipelines": [
    {
      "binding": "EVENTS",
      "stream": "events-stream",
      "remote": true
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "stream": {
    "binding": "VIDEO",
    "remote": true
  },
  "unsafe": {
    "bindings": [
      {
        "name": "EXPERIMENT",
        "type": "experimental"
      }
    ]
  },
  "vpc_services": [
    {
      "binding": "PRIVATE_API",
      "service_id": "private-api",
      "remote": true
    }
  ]
}
